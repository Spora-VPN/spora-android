<?xml version="1.0" encoding="utf-8"?><!--
   See backup_rules.xml for why shared prefs must not leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="connlog" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="connlog" />
    </device-transfer>
</data-extraction-rules>
