<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only: lets adb drive UI state for screenshots/testing.
             DUMP is a signature|privileged permission that the adb shell holds,
             so third-party apps on the device cannot send to this receiver. -->
        <receiver
            android:name=".DebugStateReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="to.spora.android.debug.STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
